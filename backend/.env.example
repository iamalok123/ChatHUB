# ChatHUB Backend Configuration

# Server & Network Binding
APP_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://chathub.vercel.app
ALLOWED_HOSTS=127.0.0.1,localhost,chathub-backend.onrender.com,chathub-backend.up.railway.app
ENVIRONMENT=development

# Database Configuration (Neon PostgreSQL)
# Primary Connection: Pooled connection string recommended for production
DATABASE_URL=
# Direct connection (optional, for direct migrations/DDL)
DIRECT_DATABASE_URL=
# Local SQLite fallback (used only if DATABASE_URL is empty)
DB_PATH=./data/chathub.db

# Neon Services (Future Integration / Optional)
# Neon Auth (sign-in identity provider)
NEON_AUTH_BASE_URL=
# Neon AI Gateway (OpenAI-compatible routing & caching)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# Vector Database (Qdrant Cloud / Future Scale)
# Leave empty to use ChatHUB's built-in NumPy cosine similarity
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=chathub_memories

# Google Gemini AI (Official google-genai SDK)
LLM_MODE=auto
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=120

# Authentication & Security
ALLOW_SIGNUP=true
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Budgets & Logging
HISTORY_TOKEN_BUDGET=3000
MEMORY_TOKEN_BUDGET=800
EXTRACTION_MAX_CANDIDATES=5
LOG_LEVEL=INFO
