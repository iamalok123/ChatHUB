# ChatHUB Backend Configuration

# Server & Network Binding
APP_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://chathub.vercel.app
ALLOWED_HOSTS=127.0.0.1,localhost,chathub-backend.onrender.com,chathub-backend.up.railway.app
ENVIRONMENT=development

# Database Configuration (PostgreSQL with NeonDB)
# Production: Set DATABASE_URL to your pooled NeonDB PostgreSQL connection string
# Example: postgresql://user:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local Dev fallback: If omitted, ChatHUB uses SQLite at DB_PATH
DATABASE_URL=
DB_PATH=./data/chathub.db

# Vector Database (Qdrant Cloud)
# Production: Set QDRANT_URL and QDRANT_API_KEY from your Qdrant Cloud cluster
# Example: https://xxxx.cloud.qdrant.io:6333
# Local Dev fallback: If omitted, ChatHUB uses internal dense cosine similarity
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=chathub_memories

# Google Gemini AI (Official google-genai SDK)
# LLM_MODE: 'auto' (Gemini if key present, else mock), 'gemini' (strict), 'mock' (offline)
LLM_MODE=auto
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=120

# Authentication & Security
ALLOW_SIGNUP=true
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Budgets & Heuristics
HISTORY_TOKEN_BUDGET=3000
MEMORY_TOKEN_BUDGET=800
EXTRACTION_MAX_CANDIDATES=5
LOG_LEVEL=INFO
