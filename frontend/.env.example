# ChatHUB Frontend Configuration

# Backend API Endpoint URL
# - Local development with Vite proxy or Vercel rewrites: leave empty (defaults to '/api')
# - Production with separate cross-origin backend on Render or Railway:
#   Set to your live backend service URL (without trailing slash)
#   Example: VITE_API_URL=https://chathub-backend.onrender.com
VITE_API_URL=

# Local Development Ports (optional)
PORT=5173
BACKEND_PORT=8000
