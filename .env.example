APP_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PATH=./data/branchmind.db

LLM_MODE=auto
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
