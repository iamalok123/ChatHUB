# ChartHub Server Configuration
APP_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database Configuration
# Local SQLite (default for development):
DB_PATH=./data/branchmind.db
# Production NeonDB PostgreSQL (uncomment and fill for Neon/Postgres):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vector Database (Qdrant Cloud / Container)
# Leave empty for local in-memory cosine fallback:
# QDRANT_URL=https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
# QDRANT_COLLECTION=chathub_memories

# AI Provider Configuration (Google Gemini)
LLM_MODE=auto
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=120

# Authentication & Security
ALLOW_SIGNUP=true
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
LOG_LEVEL=INFO
# Production CORS Allowed Origins (comma-separated):
# ALLOWED_ORIGINS=https://chathub.vercel.app,http://localhost:5173

# Memory & Retrieval Token Budgets
HISTORY_TOKEN_BUDGET=3000
MEMORY_TOKEN_BUDGET=800
EXTRACTION_MAX_CANDIDATES=5
