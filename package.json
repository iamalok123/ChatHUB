{
  "name": "chathub-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "ChatHUB - Git for chatbot memory",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "backend\\.venv\\Scripts\\pytest backend/tests",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "backend\\.venv\\Scripts\\ruff check backend",
    "preview": "npm --prefix frontend run preview"
  }
}
